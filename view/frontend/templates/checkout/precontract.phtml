/**
 * Hyva Checkout precontract block — read-only Annex I display.
 * Reuses MageMe\EUWithdrawal\Block\Checkout\PrecontractInfo (base module) as the
 * server-side data provider. Accordion uses native <details>/<summary> so
 * no Alpine expression is needed (Hyva Checkout's Alpine CSP-friendly build
 * does not support object literals, ternaries, or assignment expressions).
 *
 * @var \MageMe\EUWithdrawal\Block\Checkout\PrecontractInfo $block
 * @var \Magento\Framework\Escaper $escaper
 */
if (!$block->isAvailable()) {
    return;
}
$snapshot = $block->getSnapshot();
if ($snapshot === null) {
    return;
}

$sections = array_values(array_filter(array_map(
    fn(string $s) => trim($s),
    preg_split('/\n{2,}/', $snapshot->getAnnexIaText()) ?: [],
)));

$publishedDate = $block->getFormattedPublishedAt();
?>
<div class="mt-4 rounded-lg border border-blue-200 bg-blue-50 p-5">
    <div class="flex items-start justify-between gap-3">
        <h3 class="text-[16px] font-semibold leading-snug text-gray-900">
            <?= $escaper->escapeHtml(__('Right of Withdrawal — Required Information')) ?>
        </h3>
        <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-[12px] font-semibold text-blue-800 whitespace-nowrap">
            <?= $escaper->escapeHtml(__('EU Art. 6(1)(h)')) ?>
        </span>
    </div>
    <p class="mt-1.5 text-[14px] leading-relaxed text-gray-700">
        <?= $escaper->escapeHtml(__(
            'Before placing your order, please review the conditions, time limit, and procedures for exercising your %1-day right of withdrawal. This information forms part of your contract.',
            $snapshot->getPeriodDays()
        )) ?>
    </p>

    <details class="group mt-3">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded text-left text-[14px] font-semibold text-blue-700 hover:underline">
            <span><?= $escaper->escapeHtml(__('Conditions, Time Limit and Procedures for Withdrawal')) ?></span>
            <svg class="h-4 w-4 transition-transform group-open:rotate-180"
                 viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
            </svg>
        </summary>
        <div class="mt-3 space-y-2">
            <?php foreach ($sections as $section): ?>
                <p class="text-[14px] leading-relaxed text-gray-800">
                    <?= $escaper->escapeHtml($section) ?>
                </p>
            <?php endforeach ?>
        </div>
        <div class="mt-4 border-t border-blue-200 pt-3">
            <a class="inline-flex items-center rounded border border-blue-600 bg-white px-4 py-2 text-[14px] font-semibold text-blue-700 hover:bg-blue-50"
               href="<?= $escaper->escapeUrl($block->getDownloadAnnexIbUrl()) ?>"
               target="_blank" rel="noopener">
                <?= $escaper->escapeHtml(__('Download Model Withdrawal Form (Annex I(B))')) ?>
            </a>
            <p class="mt-2 text-[13px] text-gray-500">
                <?= $escaper->escapeHtml(__('Optional legal template — not required to use; you can also exercise the right of withdrawal by any unequivocal statement.')) ?>
            </p>
        </div>
    </details>

    <p class="mt-3 text-[12px] text-gray-500">
        <?= $escaper->escapeHtml(__(
            'Withdrawal Information v%1 — Issued %2',
            $snapshot->getVersion(),
            $publishedDate,
        )) ?>
    </p>
</div>
